FROM node:22-bookworm-slim AS node
FROM composer:2 AS composer
FROM php:8.5.12-cli-bookworm

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    NODE_PATH=/usr/local/lib/node_modules

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=composer /usr/bin/composer /usr/local/bin/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium git unzip postgresql-client libpq-dev libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libbz2-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath bz2 exif gd intl pcntl pdo_mysql pdo_pgsql pgsql sockets zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /usr/local/bin/node /usr/bin/node \
    && ln -s /usr/local/bin/npm /usr/bin/npm \
    && npm install --global puppeteer@25.10.0 \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

RUN printf 'memory_limit=512M\n' > /usr/local/etc/php/conf.d/sonar.ini

WORKDIR /var/www/html
EXPOSE 80
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=80", "--no-reload"]
